# --- Mapbox (klient) --------------------------------------------------------
# Public token (pk.*). Begræns det til jeres domæner i Mapbox-kontoen.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Matrikel-tileset fra MTS, fx "brugernavn.ejendomskort-jordstykker".
# Tom = matrikler hentes som GeoJSON fra /api/jordstykker (ingen farvelægning).
NEXT_PUBLIC_MAPBOX_TILESET_ID=
NEXT_PUBLIC_MAPBOX_TILESET_LAYER=jordstykker
# Startvisning "lng,lat,zoom" (standard: Frederiksberg).
NEXT_PUBLIC_INITIAL_VIEW=12.5323,55.6794,14.5

# --- Convex (valgfri, anbefalet) ---------------------------------------------
# Sættes automatisk af `npx convex dev` lokalt og af `convex deploy` på Vercel.
NEXT_PUBLIC_CONVEX_URL=
# Kun på Vercel: production deploy key fra Convex-dashboardet.
CONVEX_DEPLOY_KEY=

# --- Datafordeleren (server) -------------------------------------------------
# Sæt i Convex (npx convex env set ...) OG i Vercel, hvis REST-fallbacken bruges.
# OAuth Shared Secret (foretrukket) ...
DATAFORDELER_CLIENT_ID=
DATAFORDELER_CLIENT_SECRET=
# ... eller en API-nøgle til ikke-beskyttede data.
DATAFORDELER_API_KEY=
# Valgfrit: tjenesteversioner, fx "BBR=v3,DAR=v3,MAT=v2,EBR=v1,VUR=v2".
DATAFORDELER_VERSIONS=

# --- Adressesøgning ----------------------------------------------------------
# Token til Klimadatastyrelsens Adressevælger (anmod om et på support@kds.dk).
ADRESSEVAELGER_TOKEN=

# --- Tileset-pipeline (kun scripts/build-tileset.ts) -----------------------------
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=
MAPBOX_TILESET=ejendomskort-jordstykker
# Pilotområde "minLng,minLat,maxLng,maxLat" (standard: Frederiksberg).
PILOT_BBOX=
