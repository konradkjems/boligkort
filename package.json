{
  "name": "ejendomskort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "convex:codegen": "convex codegen",
    "convex:codegen:offline": "convex codegen --system-udfs --typecheck disable",
    "tileset": "tsx scripts/build-tileset.ts",
    "tileset:dry": "tsx scripts/build-tileset.ts --dry-run"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "mapbox-gl": "^3.32.0",
    "next": "16.3.7",
    "proj4": "^2.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
